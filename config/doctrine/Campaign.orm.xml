<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                  https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Domain\Campaign" table="campaigns">
        <id name="id" type="guid" column="id">
            <generator strategy="NONE"/>
        </id>

        <field name="type" type="string" column="type" length="50"/>
        <field name="status" type="string" column="status" length="20"/>
        <field name="scheduledAt" type="datetime_immutable" column="scheduled_at"/>
        <field name="audienceCriteria" type="json" column="audience_criteria"/>
        <field name="editorialId" type="string" column="editorial_id" length="255"/>
        <field name="createdAt" type="datetime_immutable" column="created_at"/>
        <field name="updatedAt" type="datetime_immutable" column="updated_at"/>

        <indexes>
            <index columns="status,scheduled_at" name="idx_status_scheduled"/>
            <index columns="editorial_id" name="idx_editorial"/>
        </indexes>
    </entity>

</doctrine-mapping>
